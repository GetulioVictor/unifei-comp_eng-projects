# Modo do WAF: On (bloqueia) | DetectionOnly (so registra) | Off (desligado)
WAF_MODE=Off

# Nivel de paranoia do OWASP CRS: 1 (padrao) a 4 (mais rigoroso, mais falsos positivos)
WAF_PARANOIA=1

# Pontuacao de anomalia para bloquear uma requisicao (menor = mais rigoroso)
WAF_ANOMALY_INBOUND=5

# Senha do Redis (estado compartilhado entre as replicas)
REDIS_PASSWORD=lab-sd-redis-2026

# false = login vulneravel a SQL injection (de proposito, para demonstrar o WAF)
# true  = login com consulta parametrizada (correcao no codigo)
APP_SQL_SEGURO=false
